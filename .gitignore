*.nupkg
*.snupkg
AppPackages/
BundleArtifacts/

# NuGet
packages/
*.nuget.props
*.nuget.targets
project.lock.json

# Temporary encrypted/decrypted files (AxCrypt work products)
*.axx.tmp
*-decrypted.*
*.tmp.axx
axcrypt-temp/

# SBOM / scan outputs generated locally
*.sbom.json
*.spdx.json
gitleaks-report.json
