# Local configuration and secrets — never commit these
appsettings.local.json
appsettings.*.local.json
secrets.json
*.secrets.json
.env
.env.*
local.settings.json

# Build-time injected cloud OAuth credentials — never commit the generated file
CloudDriveSecrets.BuildTime.cs

# Certificates, keys, signing material — never commit these
*.pfx
*.p12
*.snk
*.cer
*.crt
*.der
*.pem
*.key
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
*.pubxml.user

