<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>axcrypt</AssemblyName>
    <RootNamespace>AxCrypt.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Description>AxCrypt command-line utility. Copyright (C) AxCrypt AB. Licensed under GPL-3.0-or-later.</Description>
    <Company>AxCrypt AB</Company>
    <Copyright>Copyright (C) AxCrypt AB</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\AxCrypt.Abstractions\AxCrypt.Abstractions.csproj" />
    <ProjectReference Include="..\..\shared\AxCrypt.Common\AxCrypt.Common.csproj" />
    <ProjectReference Include="..\..\shared\AxCrypt.Core\AxCrypt.Core.csproj" />
    <ProjectReference Include="..\..\shared\AxCrypt.Desktop\AxCrypt.Desktop.csproj" />
    <ProjectReference Include="..\..\shared\AxCrypt.Mono\AxCrypt.Mono.csproj" />
  </ItemGroup>

</Project>
